# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Группа сотрудников, где ставят «+». Узнать: добавить бота в группу и написать /chatid
GROUP_CHAT_ID=-1001111111111
# Куда отправлять заявку (группа кухни или личка повара)
KITCHEN_CHAT_ID=-1002222222222

# Telegram ID администраторов через запятую (узнать: /chatid)
ADMIN_IDS=111111111

TIMEZONE=Asia/Tashkent
POLL_TIME=09:00
REMIND_TIME=10:15
REPORT_TIME=10:45
WORKDAYS=mon,tue,wed,thu,fri
# Цена обеда в сумах (0 — не считать). Всё это потом можно менять в /admin
PRICE=0

DB_PATH=lunch.db
